{
  "manifest_version": 3,
  "name": "MARG Books & ERP to B2B Pharma Bridge",
  "version": "1.1.0",
  "description": "Sync live inventory, stock batches, and outstanding data from MARG Cloud or uploaded/downloaded XLS/XLSX stock files directly to your Next.js B2B app.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "MARG Bridge & Stock Upload",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://*.margbooks.com/*",
    "https://margbooks.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.margbooks.com/*",
        "https://margbooks.com/*"
      ],
      "js": [
        "lib/xlsx.full.min.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/interceptor.js",
        "lib/xlsx.full.min.js"
      ],
      "matches": [
        "https://*.margbooks.com/*",
        "https://margbooks.com/*"
      ]
    }
  ]
}
